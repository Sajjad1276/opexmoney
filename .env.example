# Telegram Bot
BOT_TOKEN=your_bot_token_here

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Redis
REDIS_URL=redis://default:password@host:6379

# Vercel Telegram Webhook
TELEGRAM_WEBHOOK_URL=https://your-project.vercel.app/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret
TELEGRAM_WEBHOOK_SETUP_TOKEN=replace_with_another_random_secret

# AI (optional)
AI_ENABLED=false
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_key_here

# GitHub (optional)
SUPPORT_GITHUB_TOKEN=your_github_token_here

# Admin Panel
ADMIN_USER_IDS=123456789,987654321
MINI_APP_URL=https://your-project.vercel.app
DEV_MODE=false

# Railway (legacy; not required for Vercel)
RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=10
PORT=8000
